{
  "name": "sos-oticas-prime",
  "private": true,
  "version": "1.0.0",
  "description": "SOS Óticas Prime - Sistema de Gestão Óptica e Ordem de Serviço",
  "author": "SOS Óticas Prime",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:start": "electron .",
    "dist:win": "npm run build && electron-builder --win portable",
    "dist:mac": "npm run build && electron-builder --mac dir"
  },
  "build": {
    "appId": "br.com.sosoticasprime.app",
    "productName": "SOS Oticas Prime",
    "directories": {
      "output": "instaladores"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "portable",
      "artifactName": "SOS-Oticas-Prime-Setup.exe"
    },
    "mac": {
      "target": "dir"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "lucide-react": "^0.474.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "vite": "^6.0.5"
  }
}
